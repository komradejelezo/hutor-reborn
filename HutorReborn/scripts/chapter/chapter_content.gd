extends RefCounted
## Original chapter writing. Options are rebuilt from discovered state, not hidden UI choices.
const E="res://assets/interiors/stage44/"
const F="res://assets/interiors/stage45/"
const ITEMS={
    "copy":["Выписка старосты","Улика","В описи зачёркнута строка о ночном свете. Прежняя семья запирала границу изнутри; ключ от шкафа — под половицами.",E+"documents.png"],
    "dishes":["Посуда со стола","Квестовый","Нужно отнести к кухонной стойке трактира.",E+"shelf_cups.png"],
    "axe":["Топор Мирона","Улика","У обуха три зарубки. Чёрная смола пахнет холодной золой.",F+"axe.png"],
    "root":["Чёрный корень","Улика","Срез не сохнет, хотя древесина давно мертва.",E+"herbs.png"],
    "cloth":["Обрывок ткани","Улика","Синий лён зажат между корнями. На краю следы свежей смолы.",F+"linen_line.png"],
    "handle":["Сломанная рукоять","Улика","Дерево сломали поперёк волокон, словно выкручивали мокрую тряпку.",F+"axe.png"],
    "diary":["Старый дневник","Улика","«Мы думали, что оно живёт в лесу. Но лес лишь держит его снаружи».",E+"documents.png"],
    "tincture":["Лечебная настойка","Расходуемый","Восстанавливает 30 HP. Расходуется также в сюжетном бою.",E+"bottles.png"],
    "valerian":["Валериана","Материал","Светлый корень, резкий запах. Один из двух нужных ингредиентов.",E+"herbs.png"],
    "thyme":["Чабрец","Материал","Мелкие сухие листья пахнут дымом и мёдом.",E+"herb_line.png"],
    "poison":["Болиголов","Материал","Пятнистый стебель. Травница запрещала его брать. Можно выбросить и найти нужный куст.",E+"herbs.png"],
    "toy":["Сломанная игрушка","Квестовый","Деревянная лошадка с тележкой без колеса. Её хозяин — сын дровосека.","res://assets/environment/krivaya_sosna/objects/cart.png"],
    "wheel":["Деревянное колесо","Материал","Подходит к игрушке. Верстак находится в общем складе.","res://assets/environment/krivaya_sosna/objects/cart.png"],
    "fixed_toy":["Починенная лошадка","Квестовый","Колесо закреплено деревянным штифтом.","res://assets/environment/krivaya_sosna/objects/cart.png"],
    "logs":["Связка дров","Материал","Для печи в доме семьи дровосека.","res://assets/environment/krivaya_sosna/objects/logs.png"],
    "mug":["Оставленная кружка","Квестовый","На ручке вырезано М. Брат травницы может знать хозяина.","res://assets/npc/innkeeper546/game/mug_empty.png"],
    "dry":["Сухие травы","Материал","Связки для сортировки на столе травницы.",E+"herb_line.png"],
    "bait":["Копчёное мясо","Расходуемый","Можно оставить на лесной тропе и отвлечь волков.",E+"dry_food.png"],
    "key":["Старый ключ","Квестовый","Открывает шкаф в заброшенном доме.",E+"chest.png"]}
const WITNESSES={
    "woodcutter":"Мирон пошёл за овраг один. Я слышал его топор ещё до рассвета. Только Мирон всегда работал с полудня. Возле северной тропы остались инструменты; не трогай смолу голой рукой.",
    "herbalist_brother":"Дровосек говорит — один. А я видел двоих у телеги. Второй шёл так тихо, что листья не шевелились. У Мирона была синяя рубаха. Три зарубки на обухе я ему вырезал сам.",
    "woodcutter_wife":"Муж вернулся с пустыми руками. Ночью он вышел к двери и сказал кому-то: «Я не стану открывать». Он уверяет, что Мирон пропал утром. Но его плащ был мокрым уже вечером.",
    "woodcutter_son":"За пустым домом горело окно. Кто-то стоял у дерева и делал вид, что рубит. Топора я не видел. А три стука были. Я спрятал свою лошадку под одеяло."}
static func options(s:RefCounted,id:String,evening:bool=false) -> Array:
    var o:Array=[]
    if id=="woodcutter" and not s.has("greeted"):
        o.append(["greeted","Где здесь можно переночевать?","Трактир на южной дороге, у большого крыльца. Только в лес после заката не суйся. Там работа иногда сама работника ищет."])
    if id=="innkeeper" and not s.has("lodging"):
        if s.money>=3:o.append(["pay","Заплатить три монеты за ночлег.","Половина твоих дорожных денег — за сухую постель и дверь с засовом. До утра тебя не потревожу. А если услышишь стук — не отвечай."])
        if not s.has("inn_work"):o.append(["inn_work","Денег немного. Дам руку по хозяйству.","Собери посуду с гостевого стола и отнеси к кухонной стойке. За это постель твоя. За печью есть тюфяк; не перепутай его с выходом."])
        if s.has("dishes_delivered"):o.append(["work_paid","Посуда убрана. Мы договорились о ночлеге.","Работа сделана чисто. Оставайся. Тюфяк за печью свободен; проснёшься — найдёшь на стойке хлеб."])
    if id=="innkeeper":
        if not s.has("mug_started"):o.append(["mug_started","Чья кружка осталась на столе?","Вот и узнай. Я ставлю её на стол каждый вечер. Уже неделю никто не пьёт. Осмотри ручку и спроси у того, кто работает в лесу."])
        if s.has("mug_owner") and not s.has("mug_done"):o.append(["mug_done","Брат травницы узнал кружку Мирона.","Мирон рассчитывался вперёд. Я говорил, что он уехал. Так легче было объяснить, почему его место пустует. Возьми мясо в дорогу и эти две монеты."])
        if not s.has("bait_received"):o.append(["bait_received","Продашь немного еды в дорогу?","Край копчёного мяса отдам за помощь с разговорами. Только не ешь его возле волчьего следа: они почуют раньше тебя."])
    if id=="innkeeper_wife":o.append(["wife_hint","Почему хозяин так боится ночного стука?","Он каждый вечер запирает ставни с лесной стороны. Раньше оставлял их открытыми — ждал Мирона. А теперь он боится, что тот вернётся."])
    if s.has("night") and id in WITNESSES:
        o.append(["w_"+id,"Что ты знаешь об исчезновении Мирона?",WITNESSES[id]])
    if s.has("axe_found") and not s.decisions.has("axe"):
        if id=="elder":o.append(["axe_elder","Передать найденный топор старосте.","Я уберу его под замок. Запомни: ты нашёл его у северной тропы. Не возле дома. На этом настаиваю. На столе лежат старые описи — в них разрешаю посмотреть."])
        if id=="herbalist_brother":o.append(["axe_brother","Показать топор брату травницы.","Мирон никогда не оставлял железо в сырости. Смола здесь не с сосны: у нас такой не бывает. Я верну тебе находку. Сестре покажи срез, а не лезвие."])
    if id=="herbalist_brother" and s.count("mug")>0:o.append(["mug_owner","Узнаёшь эту кружку?","Мирон вырезал букву, когда устроился на лесозаготовки. Он говорил: если не вернусь к ужину, не оставляйте мне место. Мы смеялись. Больше не смешно."])
    if id=="herbalist":
        if s.has("investigation") and not s.has("herbs_started"):o.append(["herbs_started","Ты узнаёшь чёрную смолу?","У старой сосны я видела такие корни. Принеси валериану с белым цветком и чабрец с мелкими листьями: две заросли у западной опушки. Не бери пятнистый стебель — это болиголов. Сперва осмотри растение."])
        if s.has("herbs_started") and not s.has("herbs_done"):
            if s.count("valerian")>0 and s.count("thyme")>0:o.append(["herbs_done","Я принёс валериану и чабрец.","Годится. Однажды человек принёс мне такой корень и спросил, почему чужая женщина спит в его доме. Это была его жена. Дети стояли рядом, а он их тоже не узнал. Возьми настойку. Спроси старика о трёх зарубках."])
            if s.count("poison")>0:o.append(["discard_poison","Кажется, я перепутал растение.","Это болиголов. Выбросим его, руки вымоем. Ничего непоправимого не случилось: нужные кусты всё ещё на опушке."])
        if not s.has("dry_started"):o.append(["dry_started","Нужна помощь с запасами?","На складе висят сухие связки. Принеси их к моему столу, отдели потемневшие листья от светлых. За работу дам настойку."])
        if s.has("dry_sorted") and not s.has("dry_done"):o.append(["dry_done","Лекарственные запасы перебраны.","Спасибо. Смола в старых связках темнела даже зимой. Значит, это началось не сейчас. Сохрани настойку — лес не любит торопливых."])
    if id=="woodcutter_son":
        if not s.has("toy_started"):o.append(["toy_started","Что случилось с твоей лошадкой?","Колесо укатилось к колодцу. Можешь починить её на складском верстаке? Я ночью туда сам не пойду."])
        if s.count("fixed_toy")>0 and not s.has("toy_done"):o.append(["toy_done","Держи, колесо снова крутится.","Спасибо! Если старик спросит, скажи, что я больше не прячусь у пустого дома. Я видел там Мирона. Только он стоял лицом к стене."])
    if id=="woodcutter_wife":
        if not s.has("wood_started"):o.append(["wood_started","Чем помочь по хозяйству?","От поленницы во дворе принеси две связки к печи. Муж дрова оставляет на улице: говорит, ночью в них кто-то шевелится."])
        if s.has("wood_delivered") and not s.has("wood_done"):o.append(["wood_done","Дрова сложены возле печи.","Спасибо. Вот две монеты. Муж теперь иногда стоит у северной тропы, будто кого-то ждёт. Я думала — Мирона. Теперь не уверена."])
    if id=="old_man":
        if not s.has("old_kindness"):o.append(["old_kindness","Не мешаю? Могу посидеть молча.","Молчать умеешь — уже хорошо. Здесь все знают, чего не следует говорить. Только молчат каждый о своём."])
        if s.has("herbs_done"):
            o.append(["warning","Что означают три зарубки на топоре?","За северным оврагом рубить запрещали. Три зарубки — не клеймо мастера, а знак границы. Сосна хранит старый заруб. Осмотри её кору."])
            if int(s.trust.get("old_man",0))>0:o.append(["old_history","Расскажи о семье из пустого дома.","Они слышали голоса прежде нас. Забили окна, закопали ключ. Однажды лес затих — и дом опустел. В описи старосты осталось прежнее имя хозяина."])
    if s.has("camp_done") and not s.decisions.has("approach"):
        if id=="herbalist":o.append(["approach_herbalist","Пойдём со мной в пустой дом.","Пойду, когда откроешь дверь ночью. Внутри держись рядом: символы я прочту, но староста узнает, что я нарушила запрет. На гнилой ставне есть три зарубки — она открывает засов."])
        if id=="elder":o.append(["approach_elder","Сообщить старосте о находках за оврагом.","В дом не пускаю. Можешь получить опись у моего стола — она объяснит, кому принадлежал шкаф. Если всё-таки полезешь через ставню, не говори, что я позволил."])
    return o
